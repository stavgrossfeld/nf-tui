    mkdir -p 14 && ln -s /Users/stav/repos/nf-tui/work/98/9ba4fe86538fbbe117a25091894d1b/test.recal.cram.stats 14/test.recal.cram.stats
    mkdir -p 16 && ln -s /Users/stav/repos/nf-tui/work/50/f85d7397a1fa31dbf5464c7e367e33/test.strelka.variants.TsTv.qual 16/test.strelka.variants.TsTv.qual
    mkdir -p 2 && ln -s /Users/stav/repos/nf-tui/work/tmp/1b/399c30d10d703d0def6642c0093fed/workflow_summary_mqc.yaml 2/workflow_summary_mqc.yaml
    mkdir -p 11 && ln -s /Users/stav/repos/nf-tui/work/4e/93d83ece108cf51a08ac99179b63d0/test.recal.table 11/test.recal.table
