    rm -f 6/test-test_L2_2_fastqc.zip
    rm -f 9/test.md.mosdepth.global.dist.txt
    mkdir -p 15 && ln -s /Users/stav/repos/nf-tui/work/40/c0df0cceb4466f4c7fdd3a46329d5a/test.strelka.variants.bcftools_stats.txt 15/test.strelka.variants.bcftools_stats.txt
    mkdir -p 17 && ln -s /Users/stav/repos/nf-tui/work/70/0ea3f7fcc14c87771a6e6eb23cf03d/test.strelka.variants.TsTv.count 17/test.strelka.variants.TsTv.count
    mkdir -p 5 && ln -s /Users/stav/repos/nf-tui/work/11/2634ad7a2193105c273c515eeef219/test-test_L2_1_fastqc.zip 5/test-test_L2_1_fastqc.zip
    mkdir -p 3 && ln -s /Users/stav/repos/nf-tui/work/18/fb192ebc70f1a0e8c764d278c7f4d2/test-test_L1_1_fastqc.zip 3/test-test_L1_1_fastqc.zip
    mkdir -p 18 && ln -s /Users/stav/repos/nf-tui/work/32/ad9c9d8d7a94cf84e0b293df575a22/test.strelka.variants.FILTER.summary 18/test.strelka.variants.FILTER.summary
